# Alamat website tanpa garis miring di akhir.
NEXT_PUBLIC_SITE_URL=https://contoh.id

# 1 = mode etalase (bilah "website contoh" dan halaman /paket). Kosongkan untuk klien.
NEXT_PUBLIC_SHOWCASE=

# Hanya untuk Paket Mandiri (panel admin). Jalankan dengan perintah berakhiran :cms.
# PAYLOAD_SECRET minimal 32 karakter acak, misalnya dari: openssl rand -hex 32
PAYLOAD_SECRET=
DATABASE_URI=file:./data/cms.db
